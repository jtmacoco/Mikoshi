# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Obsidian workspace/state (device-specific, don't sync)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Optional: ignore the whole config folder if you don't want to sync
# settings/plugins across devices at all (uncomment if desired)
# .obsidian/

# Trash / backups
.trash/
*.bak
*.tmp

# Editor swap files
*.swp
*.swo
*~

# Linux kernel module build artifacts
# Keeps: *.c, *.h, *.ko, Makefile, Kbuild

# Object files
*.o
*.o.d
*.a

# Generated module files (note: *.mod.c is generated, not source)
*.mod
*.mod.c
*.mod.o

# Kbuild command/dependency files
.*.cmd
.*.d
.tmp_versions/
.cache.mk

# Symbol and module lists
Module.symvers
Module.markers
modules.order
modules.builtin*

# Misc build output
*.symtypes
*.lst
*.dwo
*.su
*.ll
.tmp*
built-in.a


