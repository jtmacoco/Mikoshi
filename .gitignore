# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Obsidian workspace/state (device-specific, don't sync)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Optional: ignore the whole config folder if you don't want to sync
# settings/plugins across devices at all (uncomment if desired)
# .obsidian/

# Trash / backups
.trash/
*.bak
*.tmp

# Editor swap files
*.swp
*.swo
*~

# Build artifacts (Ripperdoc gigs: kernel modules + CUDA)
# Keeps: *.c, *.h, *.cu, *.cuh, Makefile, Kbuild

# Object files
*.o
*.o.d
*.a
*.ko

# Generated module files (*.mod.c is generated, not source)
*.mod
*.mod.*

# Kbuild command/dependency files
.*.cmd
.*.d
.tmp_versions/
.cache.mk

# Symbol and module lists
Module.symvers
Module.markers
modules.order
modules.builtin*

# Misc build output
*.symtypes
*.lst
*.dwo
*.su
*.ll
.tmp*
built-in.a

# CUDA gig binaries (no extension, so listed by name)
Ripperdoc/Cuda-Dev/Gigs/*/saxpy
